# Mau bien moi truong cho docker-compose.yml (chay DEV tren may).
# Cach dung: copy file nay thanh ".env" (cung thu muc) roi dien gia tri. File .env KHONG duoc commit.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Git Bash:            cp .env.example .env

# Mat khau root cua MySQL trong container dev (tu dat, vd: 23102006 neu muon giong may cu)
MYSQL_ROOT_PASSWORD=

# AI: Claude (mac dinh) hoac Gemini
AI_PROVIDER=Claude
# API key Claude (sk-ant-...)
ANTHROPIC_API_KEY=
# API key Gemini (neu dung AI_PROVIDER=Gemini)
GEMINI_API_KEY=

# (Tuy chon) JWT secret cho ban dev; bo trong se dung gia tri dev mac dinh trong docker-compose.yml
# JWT_SECRET=
