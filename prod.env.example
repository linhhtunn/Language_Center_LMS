# Mau bien moi truong cho docker-compose.prod.yml.
# Tren VPS: cp prod.env.example .env.prod  roi dien gia tri that. KHONG commit .env.prod.
# Tao chuoi ngau nhien: openssl rand -base64 48

# Ten mien (khong co https://). Hai ban ghi DNS loai A tro ve IP cua VPS.
APP_DOMAIN=app.tenmien.com
API_DOMAIN=api.tenmien.com

# Mat khau database: chuoi ngau nhien dai, khong dung lai mat khau dev.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_USER=qltt_app
MYSQL_APP_PASSWORD=

# Khoa ky token dang nhap: chuoi ngau nhien it nhat 32 ky tu.
JWT_SECRET=

# AI: Claude (mac dinh) hoac Gemini
AI_PROVIDER=Claude
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
