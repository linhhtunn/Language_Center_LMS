# Copy thanh ".env" (cung thu muc backend/) roi dien gia tri. File .env KHONG duoc commit.
#   PowerShell: Copy-Item .env.example .env

PORT=5050
NODE_ENV=development

# MySQL (dev: docker compose o thu muc goc mo cong 3307)
DATABASE_URL="mysql://root:MAT_KHAU@127.0.0.1:3307/HeThongHocOnline_Final"

# Bo trong khi dev se dung secret dev mac dinh. Production: chuoi ngau nhien >= 32 ky tu.
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Dev de trong = cho phep moi origin. Production: https://ten-mien-frontend
ALLOWED_ORIGINS=
TRUST_PROXY=false
UPLOADS_DIR=uploads

# AI: Claude (mac dinh) hoac Gemini
AI_PROVIDER=Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
